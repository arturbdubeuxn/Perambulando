{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Perambulando - entrada da interpretação v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "referenceTime",
    "categories"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "referenceTime": {
      "type": "string",
      "format": "date-time"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "isActive"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean",
            "const": true
          }
        }
      }
    }
  }
}
