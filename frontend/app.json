{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "scheme": "perambulando",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/perambulando-mark.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EF",
        "foregroundImage": "./assets/perambulando-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/perambulando-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o Perambulando use sua localização para mostrar eventos e estabelecimentos próximos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
