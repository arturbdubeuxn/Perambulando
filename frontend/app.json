{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "scheme": "perambulando",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/perambulando-mark.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EF",
        "foregroundImage": "./assets/perambulando-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/perambulando-mark.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
